# SÉCURITÉ ET ROUTAGE PRODUCTION

Options -Indexes
Options +FollowSymLinks
RewriteEngine On


# Sur le vrai site, la base est la racine "/"
RewriteBase /

# --- CORRECTION 2 : La Sécurité (INDISPENSABLE car index.php est à la racine) ---
# Interdit l'accès direct aux dossiers de code
<IfModule mod_authz_core.c>
    <DirectoryMatch "^(config|controllers|models|views|templates|logs)">
        Require all denied
    </DirectoryMatch>
</IfModule>

# Interdit l'accès aux fichiers cachés (.git, .env) et au fichier SQL
<FilesMatch "^\.|^.*\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>


# Ne pas toucher aux vrais fichiers existants (images, css, js)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tout le reste va vers index.php
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]